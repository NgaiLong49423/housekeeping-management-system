# OPTIONAL: Housekeeping Demo works without .env after database/setup-demo.sql.
# Only copy to .env if using another SQL instance, port, database, or login.
# Replace every value below with your own connection before running.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=home_cleaning_dev;encrypt=true;trustServerCertificate=true
DB_USERNAME=YOUR_SQL_USERNAME
DB_PASSWORD=YOUR_SQL_PASSWORD
DEMO_ACCOUNT_PASSWORD=CHOOSE_A_LOCAL_DEMO_PASSWORD
GOOGLE_MAPS_BROWSER_KEY=

# Optional PayOS integration. PayOS currently has no sandbox; transactions use its production service.
# Never commit real merchant credentials. See docs/payos-payment.md before enabling this flow.
PAYOS_CLIENT_ID=YOUR_PAYOS_CLIENT_ID
PAYOS_API_KEY=YOUR_PAYOS_API_KEY
PAYOS_CHECKSUM_KEY=YOUR_PAYOS_CHECKSUM_KEY
# Set public HTTPS URLs; configure the webhook URL in the PayOS payment channel as well.
PAYOS_RETURN_URL=https://YOUR_PUBLIC_HOST/payments/payos/return
PAYOS_CANCEL_URL=https://YOUR_PUBLIC_HOST/payments/payos/cancel
PAYOS_WEBHOOK_URL=https://YOUR_PUBLIC_HOST/payments/payos/webhook
