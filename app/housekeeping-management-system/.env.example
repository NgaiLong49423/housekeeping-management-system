# OPTIONAL: Housekeeping Demo works without .env after database/setup-demo.sql.
# Only copy to .env if using another SQL instance, port, database, or login.
# Replace every value below with your own connection before running.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=YOUR_DATABASE;encrypt=true;trustServerCertificate=true
DB_USERNAME=YOUR_SQL_USERNAME
DB_PASSWORD=YOUR_SQL_PASSWORD
DB_RESET_ON_STARTUP=false

# Optional MoMo Test integration. Never commit actual merchant credentials.
MOMO_BASE_URL=https://test-payment.momo.vn
MOMO_PARTNER_CODE=YOUR_MOMO_TEST_PARTNER_CODE
MOMO_ACCESS_KEY=YOUR_MOMO_TEST_ACCESS_KEY
MOMO_SECRET_KEY=YOUR_MOMO_TEST_SECRET_KEY
# Set these to public HTTPS URLs reachable by MoMo (use a tunnel during local development).
MOMO_REDIRECT_URL=https://YOUR_PUBLIC_HOST/payments/momo/return
MOMO_IPN_URL=https://YOUR_PUBLIC_HOST/payments/momo/ipn
