# Main local SQL Server database used by the default application profile.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=Housekeeping_Database;encrypt=true;trustServerCertificate=true
DB_USERNAME=YOUR_SQL_USERNAME
DB_PASSWORD=YOUR_SQL_PASSWORD
# Keep existing data by default. Set true only when you intentionally want to recreate a supported local database.
DB_RESET_ON_STARTUP=false
# Enable stale evidence-file cleanup only when you explicitly intend to prune local files.
APP_EVIDENCE_CLEANUP_ENABLED=false
# Required only when a Customer accepts compensation by bank transfer. Generate a private
# Base64 key for exactly 32 random bytes; keep it outside source control and separate per environment.
# PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# PAYOUT_ENCRYPTION_KEY=YOUR_PRIVATE_BASE64_AES_256_KEY
# VNPay sandbox for online payment (test cards only, no real money). Register at
# https://pay.vnpaytest.vn/dev-registration; VNPay emails both values. Never commit them. See docs/vnpay-payment.md.
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET
# Optional: change only if the app is not opened at http://localhost:8080.
# VNPAY_RETURN_URL=http://localhost:8080/payments/vnpay/return
# Optional VIETMAP Services API key for backend geocoding/routing/matrix calls.
# Get it from https://maps.vietmap.vn/console-v2/register; never commit your real key.
VIETMAP_API_KEY=YOUR_VIETMAP_SERVICES_KEY
VIETMAP_API_BASE_URL=https://maps.vietmap.vn
