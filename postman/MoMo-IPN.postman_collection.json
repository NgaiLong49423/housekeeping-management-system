{
  "info": {
    "name": "Gon Nha - MoMo IPN",
    "description": "Local callback contract checks. Use MoMo Test credentials and a real pending Payment_Attempt from the selected demo database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "orderId", "value": "" },
    { "key": "requestId", "value": "" },
    { "key": "amount", "value": "150000" },
    { "key": "transId", "value": "123456789" },
    { "key": "responseTime", "value": "1792752000000" }
  ],
  "item": [
    {
      "name": "Valid success IPN",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const v = key => pm.environment.get(key) || ''; ",
              "const data = 'accessKey=' + v('accessKey') + '&amount=' + v('amount') + '&extraData=&message=Successful.&orderId=' + v('orderId') + '&orderInfo=Payment test&orderType=momo_wallet&partnerClientId=&partnerCode=' + v('partnerCode') + '&payType=qr&requestId=' + v('requestId') + '&responseTime=' + v('responseTime') + '&resultCode=0&transId=' + v('transId');",
              "const signature = CryptoJS.HmacSHA256(data, v('secretKey')).toString(CryptoJS.enc.Hex);",
              "pm.variables.set('ipnSignature', signature);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Accepted idempotently', () => pm.response.to.have.status(204));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"partnerCode\": \"{{partnerCode}}\",\n  \"requestId\": \"{{requestId}}\",\n  \"orderId\": \"{{orderId}}\",\n  \"amount\": {{amount}},\n  \"orderInfo\": \"Payment test\",\n  \"orderType\": \"momo_wallet\",\n  \"partnerClientId\": \"\",\n  \"transId\": {{transId}},\n  \"resultCode\": 0,\n  \"message\": \"Successful.\",\n  \"payType\": \"qr\",\n  \"responseTime\": {{responseTime}},\n  \"extraData\": \"\",\n  \"signature\": \"{{ipnSignature}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/payments/momo/ipn"
      }
    },
    {
      "name": "Duplicate success IPN is acknowledged safely",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const v = key => pm.environment.get(key) || ''; ",
              "const data = 'accessKey=' + v('accessKey') + '&amount=' + v('amount') + '&extraData=&message=Successful.&orderId=' + v('orderId') + '&orderInfo=Payment test&orderType=momo_wallet&partnerClientId=&partnerCode=' + v('partnerCode') + '&payType=qr&requestId=' + v('requestId') + '&responseTime=' + v('responseTime') + '&resultCode=0&transId=' + v('transId');",
              "pm.variables.set('ipnSignature', CryptoJS.HmacSHA256(data, v('secretKey')).toString(CryptoJS.enc.Hex));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Duplicate is acknowledged without a second state change', () => pm.response.to.have.status(204));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"partnerCode\": \"{{partnerCode}}\",\n  \"requestId\": \"{{requestId}}\",\n  \"orderId\": \"{{orderId}}\",\n  \"amount\": {{amount}},\n  \"orderInfo\": \"Payment test\",\n  \"orderType\": \"momo_wallet\",\n  \"partnerClientId\": \"\",\n  \"transId\": {{transId}},\n  \"resultCode\": 0,\n  \"message\": \"Successful.\",\n  \"payType\": \"qr\",\n  \"responseTime\": {{responseTime}},\n  \"extraData\": \"\",\n  \"signature\": \"{{ipnSignature}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/payments/momo/ipn"
      }
    },
    {
      "name": "Invalid signature is rejected",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Rejected', () => pm.expect(pm.response.code).to.be.oneOf([400, 401, 403]));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"partnerCode\": \"{{partnerCode}}\",\n  \"requestId\": \"{{requestId}}\",\n  \"orderId\": \"{{orderId}}\",\n  \"amount\": {{amount}},\n  \"resultCode\": 0,\n  \"signature\": \"invalid\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/payments/momo/ipn"
      }
    },
    {
      "name": "Signed but mismatched amount is rejected",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const v = key => pm.environment.get(key) || ''; ",
              "const amount = Number(v('amount')) + 1;",
              "const data = 'accessKey=' + v('accessKey') + '&amount=' + amount + '&extraData=&message=Successful.&orderId=' + v('orderId') + '&orderInfo=Payment test&orderType=momo_wallet&partnerClientId=&partnerCode=' + v('partnerCode') + '&payType=qr&requestId=' + v('requestId') + '&responseTime=' + v('responseTime') + '&resultCode=0&transId=' + v('transId');",
              "pm.variables.set('mismatchedAmount', amount);",
              "pm.variables.set('ipnSignature', CryptoJS.HmacSHA256(data, v('secretKey')).toString(CryptoJS.enc.Hex));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Rejected', () => pm.response.to.have.status(400));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"partnerCode\": \"{{partnerCode}}\",\n  \"requestId\": \"{{requestId}}\",\n  \"orderId\": \"{{orderId}}\",\n  \"amount\": {{mismatchedAmount}},\n  \"orderInfo\": \"Payment test\",\n  \"orderType\": \"momo_wallet\",\n  \"partnerClientId\": \"\",\n  \"transId\": {{transId}},\n  \"resultCode\": 0,\n  \"message\": \"Successful.\",\n  \"payType\": \"qr\",\n  \"responseTime\": {{responseTime}},\n  \"extraData\": \"\",\n  \"signature\": \"{{ipnSignature}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/payments/momo/ipn"
      }
    }
  ]
}
